# Tijori Escrow Platform — Environment Variables
# Copy to .env and fill in values

# REQUIRED: PostgreSQL connection string
# Local: postgresql://user:pass@localhost:5432/tijori
# Render: auto-populated from database (DATABASE_URL)
DATABASE_URL=postgresql://user:pass@localhost:5432/tijori

# REQUIRED: Google Gemini API key for AI verdicts
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# AI model to use (default: gemini-1.5-flash)
# Options: gemini-1.5-flash, gemini-1.5-pro, gemini-1.0-pro
AI_MODEL=gemini-1.5-flash

# Set to "true" to enable POST /api/dev/seed endpoint
# Disable in production!
ALLOW_SEED=true