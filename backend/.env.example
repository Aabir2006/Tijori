# Tijori Escrow Platform — Environment Variables
# Copy to .env and fill in values

# REQUIRED: PostgreSQL connection string
# Local: CHANGE user/pass/dbname to match your local PostgreSQL
# Render: auto-populated from database (DATABASE_URL) — DO NOT SET MANUALLY
DATABASE_URL=postgresql://user:pass@localhost:5432/tijori

# REQUIRED: Google Gemini API key for AI verdicts
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# AI model to use (default: gemini-1.5-flash-latest)
# Options: gemini-1.5-flash-latest, gemini-1.5-pro-latest, gemini-1.5-flash-8b
AI_MODEL=gemini-1.5-flash-latest

# Set to "true" to enable POST /api/dev/seed endpoint
# Disable in production!
ALLOW_SEED=true